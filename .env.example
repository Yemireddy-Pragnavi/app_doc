# Copy to .env; never commit .env. Generate independent random values.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://doctor:REPLACE_ME@localhost:5432/security_doctor
REDIS_URL=redis://localhost:6379/0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/callback
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
# Local HTTP only. Must be true for HTTPS production.
COOKIE_SECURE=false
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional explanation layer; no source snippets or credentials are sent.
ALLOW_LLM_EXPLANATIONS=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional encrypted S3 storage for normalized reports only.
REPORT_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Production reverse proxy (compose.production.yaml)
APP_DOMAIN=
# Exact authorized staging hostnames, comma-separated. No wildcards or URLs.
RUNTIME_ALLOWED_HOSTS=
